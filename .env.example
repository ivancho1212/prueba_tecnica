# ---------------------------------------------------------------------------
# Plantilla de configuración. `make setup` la copia a .env (NO versionado) y
# genera las llaves criptográficas vacías. Nada del código lee valores fijos:
# todo entra por variables de entorno (C6).
#
# Las credenciales de Postgres de abajo son EFÍMERAS y SOLO para evaluación
# local: deben coincidir con entrega.yaml para que el evaluador y
# `make verificar` puedan conectarse (ver DECISIONS.md ADR-002).
# ---------------------------------------------------------------------------

# --- Postgres (docker-compose + pipeline) ---
PG_HOST=localhost
PG_PORT=5432
PG_BIND=127.0.0.1
PG_DATABASE=bia_datos

PG_SUPERUSER=bia_admin
PG_SUPERPASSWORD=ev-su-4Qm9xT2vLp8Wz

PG_ROL_INGESTA_USER=rol_ingesta
PG_ROL_INGESTA_PASSWORD=ev-in-7Hc3nR5bKf1Yd
PG_ROL_ANALISTA_USER=rol_analista
PG_ROL_ANALISTA_PASSWORD=ev-an-2Vw8pJ6sGq4Tn
PG_ROL_AUDITOR_USER=rol_auditor
PG_ROL_AUDITOR_PASSWORD=ev-au-9Lk5mD1zXe3Rb

# --- Llaves criptográficas (C3) ---
# Vacías a propósito: `make setup` genera un valor aleatorio por máquina.
# Nunca se versionan ni se comparten con el evaluador: el superusuario de
# Postgres NO debe poder descifrar la PII.
BIA_ENC_KEY=
BIA_HMAC_KEY=

# --- Kafka / Redpanda ---
KAFKA_PORT=9092
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=mediciones.raw

# --- Pipeline ---
BIA_DATA_DIR=data
BIA_OUT_DIR=out
BIA_LOG_DIR=logs
BIA_LOG_LEVEL=INFO
